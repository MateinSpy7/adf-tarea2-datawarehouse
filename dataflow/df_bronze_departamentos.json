{
	"name": "df_bronze_departamentos",
	"properties": {
		"folder": {
			"name": "bronze"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "catalogo_departamentos_csv",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "silver_departamentos",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn4"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          municipio_id as string,",
				"          municipio_nombre as string,",
				"          departamento as string,",
				"          codigo_departamento as string,",
				"          zona_geografica as string,",
				"          es_capital_departamental as boolean,",
				"          poblacion_depto_estimada as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false) ~> source1",
				"source1 derive(municipio_id = trim(municipio_id),",
				"          municipio_nombre = lower(trim(municipio_nombre)),",
				"          departamento = lower(trim(departamento))) ~> derivedColumn1",
				"derivedColumn1 derive(municipio_nombre = initCap(trim(regexReplace(toString(municipio_nombre), '\\\\s+', ' ')))) ~> derivedColumn2",
				"derivedColumn2 derive(poblacion_depto_estimada = iifNull(poblacion_depto_estimada,0.0,poblacion_depto_estimada)) ~> derivedColumn4",
				"derivedColumn4 aggregate(groupBy(codigo_departamento,",
				"          departamento),",
				"     conteo_dummy = count(1)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          id_departamento as string,",
				"          nombre_departamento as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          id_departamento = codigo_departamento,",
				"          nombre_departamento = departamento",
				"     )) ~> sink1"
			]
		}
	}
}